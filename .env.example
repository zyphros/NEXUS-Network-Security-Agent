# Copy this file to .env to override the safe defaults.
POLL_SECONDS=5
AI_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:3b
AI_COOLDOWN_SECONDS=300
AI_TIMEOUT_SECONDS=120

# Optional, read-only security event ingestion. Syslog listens on loopback by default.
SYSLOG_UDP_ENABLED=false
SYSLOG_UDP_HOST=127.0.0.1
SYSLOG_UDP_PORT=5514
SYSLOG_UDP_MAX_SEVERITY=4
WAZUH_ALERTS_FILE=
WAZUH_MINIMUM_LEVEL=7
SURICATA_EVE_FILE=
ZEEK_NOTICE_FILE=
SNORT_ALERTS_FILE=

# Increase these thresholds if you see too many benign alerts.
MAX_CONNECTIONS_ALERT=150
MAX_NEW_DESTINATIONS_ALERT=25
MAX_PROCESS_CONNECTIONS_ALERT=80
